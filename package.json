{
  "name": "mudancas-brasil",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional Mudanças Brasil — mudanças nacionais e interestaduais",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check:browser": "node -e \"process.env.PLAYWRIGHT_BROWSERS_PATH='0'; import('playwright-core').then(async ({chromium}) => {let b;try{b=await chromium.launch({headless:true,args:['--no-sandbox','--disable-dev-shm-usage']}); console.log('Chromium OK')}finally{await b?.close()}}).catch(e=>{console.error(e.message);process.exitCode=1})\"",
    "postinstall": "node scripts/install-browser.cjs",
    "diagnose:browser": "node scripts/diagnose-browser.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "pdfkit": "^0.17.2",
    "sharp": "^0.33.5",
    "playwright-core": "^1.55.0"
  }
}
