# Configure estas variáveis no painel da iContainer (NÃO coloque valores reais no GitHub).
# Chave da API Resend, com permissão de envio.
RESEND_API_KEY=
# Endereço de REMETENTE em domínio verificado no Resend, por exemplo: orcamentos@seudominio.com.br
QUOTE_FROM_EMAIL=
# Destinatário que receberá o PDF e as fotos anexadas dentro do PDF.
QUOTE_TO_EMAIL=mudancasbrasiltransporte@gmail.com

# Painel ADM (configure como variáveis secretas no iContainer)
ADMIN_USERNAME=admin_mudancas
ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_UNICA
ADMIN_SESSION_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
ADMIN_DATA_DIR=/data/mudancas-brasil
NODE_ENV=production
